{
  "name": "poolflow-site",
  "version": "1.0.0",
  "private": true,
  "description": "Build tooling for the PoolFlow marketing site (Tailwind CSS compilation).",
  "scripts": {
    "build:css": "tailwindcss -i ./assets/css/_tailwind.css -o ./assets/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./assets/css/_tailwind.css -o ./assets/css/tailwind.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.10",
    "tailwindcss": "^3.4.0"
  }
}
